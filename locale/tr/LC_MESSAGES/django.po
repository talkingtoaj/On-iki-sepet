#, python-format
msgid "No date column found. Expected one of: %(aliases)s."
msgstr "Tarih sütunu bulunamadı. Şunlardan biri beklenir: %(aliases)s."

msgid "No amount column found. Expected an amount column, or separate debit and credit columns."
msgstr "Tutar sütunu bulunamadı. Bir tutar sütunu ya da ayrı borç ve alacak sütunları beklenir."

msgid "The date is missing."
msgstr "Tarih eksik."

#, python-format
msgid "“%(value)s” is not a date we recognise."
msgstr "“%(value)s” tanıdığımız bir tarih biçimi değil."

msgid "The amount is missing."
msgstr "Tutar eksik."

msgid "This line has both a debit and a credit; only one is expected."
msgstr "Bu satırda hem borç hem alacak var; yalnızca biri beklenir."

msgid "This line has more columns than the header. The file's delimiter or quoting looks wrong, so the amount cannot be read safely."
msgstr "Bu satırda başlıktan fazla sütun var. Dosyanın ayırıcısı veya tırnak kullanımı hatalı görünüyor; bu nedenle tutar güvenle okunamaz."

msgid "The amount is zero, so there is nothing to record."
msgstr "Tutar sıfır, bu nedenle kaydedilecek bir şey yok."

msgid "The file is empty."
msgstr "Dosya boş."

msgid "The file has a header but no rows."
msgstr "Dosyada başlık var ancak satır yok."

msgid "The file's text encoding is unreadable."
msgstr "Dosyanın metin kodlaması okunamıyor."

msgid "Excel support requires the openpyxl package."
msgstr "Excel desteği için openpyxl paketi gereklidir."

msgid "PDF support requires the pdfplumber package."
msgstr "PDF desteği için pdfplumber paketi gereklidir."

msgid "No table could be read from this PDF. Bank PDFs vary; exporting the statement as CSV or Excel is more reliable."
msgstr "Bu PDF'ten tablo okunamadı. Banka PDF'leri değişkendir; ekstreyi CSV veya Excel olarak indirmek daha güvenilirdir."

msgid "Statements must be a CSV, Excel or PDF file."
msgstr "Ekstreler CSV, Excel veya PDF dosyası olmalıdır."

#, python-format
msgid "This line is in %(row)s but the account is %(account)s."
